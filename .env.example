# Copy to .env for local development. Never commit real credentials.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=loginapp
MYSQL_USER=loginuser
MYSQL_PASSWORD=change-this-db-password
MYSQL_HOST=mysql_db
MYSQL_PORT=3306

FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
FLASK_PORT=5000
BCRYPT_LOG_ROUNDS=12
FRONTEND_PORT=8080

# Comma-separated origins. Use explicit origins in production.
ALLOWED_ORIGINS=http://localhost:8080
